# 관리자 앱과 같은 값(32자 이상 임의 문자열). 비어 있으면 모든 요청이 401
INTERNAL_API_TOKEN=change-me

# 탐지 모델: coco-person(기본, 사람 몸) | head(YOLO-CROWD 머리). parkpulse-docs decisions/0001
DETECTOR=coco-person

# 가중치 파일 경로 (저장소에 커밋하지 않음). DETECTOR에 맞는 파일이어야 한다
YOLO_WEIGHTS=/path/to/weights.pt

# 탐지 신뢰도 하한, 입력 크기, 초당 분석 프레임 수(정확도·속도는 측정 전 — 측정 후 decisions/0001에서 확정)
DETECT_CONF=0.3
DETECT_IMGSZ=960
ANALYZE_FPS=5

# 공유 폴더 경로. DUMMY 영상은 이 아래 dummy/videos/ 에 둔다
MEDIA_ROOT=/srv/media

# 더미 분석 캐시(박스)를 두는 분석 서버 로컬 폴더(공유 폴더가 아님)
CACHE_DIR=/var/lib/analyzer/cache

# 관리자 앱 내부 통신 주소(상태 보고, 결과 전송 등). 관리자 앱의 컨텍스트 경로 /admin까지 적는다
ADMIN_INTERNAL_BASE_URL=http://localhost:8082/admin

# 관리자 앱에 못 보낸 1초 결과를 보관해 다시 보내는 시간(초)
RESULT_RETRY_BUFFER_SEC=300

HOST=0.0.0.0
PORT=5000
